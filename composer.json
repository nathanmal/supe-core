{
    "name": "nathanmal/supe-core",
    "description": "Core module loader, service container, and shared contracts for the Supe WordPress ecosystem.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "yoast/wp-test-utils": "^1.2",
        "wp-phpunit/wp-phpunit": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Supe\\Core\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Supe\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "phpunit --configuration phpunit.xml.dist",
        "test:feature": "phpunit --configuration phpunit-integration.xml.dist"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
